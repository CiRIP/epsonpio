export CYGWIN=nodosfilewarning

TOOL_DIR = C:/EPSON/GNU33
TARGET   = fls

GCC     = $(TOOL_DIR)/xgcc
LD      = $(TOOL_DIR)/ld
OBJCOPY = $(TOOL_DIR)/objcopy
OBJDUMP = $(TOOL_DIR)/objdump

CFLAGS  = -B$(TOOL_DIR)/ -mc33pe -gstabs -medda32 -O1 -I$(TOOL_DIR)/include -fno-builtin -mlong-calls -Wall -Werror-implicit-function-declaration -std=c99
ASFLAGS = -B$(TOOL_DIR)/ -mc33pe -c -xassembler-with-cpp -Wa,--gstabs -Wa,-medda32
LDFLAGS = -Map $(TARGET).map -N -T $(TARGET).lds

OBJS    = entrypoint.o main.o packbits.o crc.o
PAYLOAD = ../web/payload.js

.PHONY: all clean

all: $(PAYLOAD)

$(PAYLOAD): $(TARGET).bin
	echo "// generated by fls/Makefile" > $@
	echo "const PAYLOAD = [" >> $@
	$(OBJDUMP) -s -b binary $< | sed -n '/^ [0-9a-f]/{s/^ [0-9a-f]* \(.\{35\}\).*/"\1",/;s/ //g;p;}' >> $@
	echo "].join(\"\");" >> $@

$(TARGET).bin: $(TARGET).elf
	$(OBJCOPY) -I elf32-little -O binary $< $@

$(TARGET).elf: $(OBJS) $(TARGET).lds
	$(LD) $(LDFLAGS) -o $@ $(OBJS)

%.o: %.s
	$(GCC) $(ASFLAGS) -o $@ $<

%.o: %.c *.h
	$(GCC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(TARGET).elf $(TARGET).map $(TARGET).bin
